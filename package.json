{
  "name": "monkey-client",
  "version": "0.2.0",
  "description": "Monkey Client — a jungle-themed Minecraft launcher",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gg.monkeyclient.launcher",
    "productName": "Monkey Client",
    "files": [
      "electron/**/*",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
